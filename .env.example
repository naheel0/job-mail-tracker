# Copy to .env and fill in real values. .env is gitignored - never commit it.
# Optional: omit IMAP_* lines entirely to use manual .eml export instead of --sync.

# --- IMAP (any provider: imap.gmail.com, imap-mail.outlook.com, imap.mail.yahoo.com) ---
IMAP_HOST=imap.gmail.com
IMAP_USER=you@gmail.com
# Gmail: enable 2-Step Verification, then create an App Password
# (Google Account -> Security -> App passwords). NOT your account password.
IMAP_PASSWORD=your-16-char-app-password

# --- Optional overrides ---
# IMAP_SINCE_DAYS=30        # how far back the first sync goes
# OLLAMA_MODEL=llama3.2:3b  # must be an exact tag: `ollama list` shows what you have
# OLLAMA_HOST=http://localhost:11434
